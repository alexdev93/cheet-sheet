# This file is a reference for which variables the app needs — it does not
# drive docker-compose.yml or CI. Those pull the real values at runtime from
# the "cheet-sheet" envvault project (the same one everywhere: local dev,
# Docker Compose, CI, and the deployed app — see package.json's scripts and
# .github/workflows/ci.yml), so the values below must be kept in sync with
# what's stored there.
#
# Don't have envvault set up, or want a plain local setup without it? Copy
# this file to .env and fill in real values — prisma.config.ts and the seed
# script load .env directly (via `dotenv/config`) as a fallback:
#   cp .env.example .env
# Never commit .env — it's already in .gitignore.
#
# Quick start (local, no Docker, no envvault):
#   1. Start/point at a Postgres instance and set DATABASE_URL below.
#   2. Generate SESSION_SECRET (command shown next to it).
#   3. Pick an admin password, run `npm run auth:hash -- "your-password"`,
#      paste the output into ADMIN_PASSWORD_HASH.
#   4. npx prisma migrate deploy && npm run db:seed && npx next dev
#      (bypassing the npm-script wrappers, which call `envvault run`)
#
# Using docker-compose.yml instead? It no longer runs its own Postgres
# container or reads .env — DATABASE_URL must come from the "cheet-sheet"
# envvault project and point at a Postgres instance reachable from inside
# the container (not "localhost"). Put ENV_VAULT_TOKEN below; compose passes
# it through to the app/migrate containers.
ENV_VAULT_TOKEN="paste-your-envvault-api-token-here"

# --- Database --------------------------------------------------------------

# PostgreSQL connection string: postgresql://<user>:<password>@<host>:<port>/<database>?schema=public
#
# Local Postgres (matches a plain `npm run dev` setup, e.g. Postgres.app,
# Homebrew, or a native install listening on localhost):
DATABASE_URL="postgresql://knowledge:knowledge@localhost:5432/knowledge_center?schema=public"
#
# Free-tier hosted Postgres (Neon, Supabase, Railway, etc.) — copy the
# connection string they give you, e.g.:
# DATABASE_URL="postgresql://myuser:mypassword@ep-cool-example-123456.us-east-2.aws.neon.tech/knowledge_center?sslmode=require"

# --- Auth --------------------------------------------------------------------

# Random 32+ byte secret used to sign the admin session cookie (JWT, HS256).
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Example output (do NOT reuse this one — generate your own):
#   K3n8mF2xQpL9vR7yT4wZ1jH6sC0aE5dN8bU2iO9gV3k=
SESSION_SECRET="change-me-to-a-long-random-string"

# The single admin account. This app is public-read / single-admin-write:
# anyone can browse and search, only this account can capture/edit/delete.
# Generate the hash with (run against your own chosen password):
#   npm run auth:hash -- "correct-horse-battery-staple"
# Example hash shape (yours will differ — this one is not a real password hash):
#   $2a$12$N9qC7hZ0yWkP1jXeV3mFAuLg8sD2tR6bQ4nH1cY5oI7wZ0aE9pKxS
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD_HASH="$2a$12$replace-with-a-real-bcrypt-hash-from-npm-run-auth-hash"

# --- Attachments ---------------------------------------------------------------

# Where uploaded images/screenshots/diagrams/PDFs are stored on disk (see
# src/lib/storage.ts). Relative paths resolve against the process's working
# directory. The Docker image overrides this to "/app/data/attachments" and
# mounts a named volume there (see docker-compose.yml) so uploads survive
# container restarts — you shouldn't need to change it for Docker use.
ATTACHMENTS_DIR="./data/attachments"

# Per-file upload size limit, in megabytes.
MAX_ATTACHMENT_SIZE_MB="10"

# --- Public site config --------------------------------------------------------

# Public origin of the deployment, used for absolute links/metadata (no
# trailing slash). Change this to your real domain once deployed, e.g.
# "https://knowledge.example.com".
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
