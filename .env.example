# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string. The docker-compose service below matches this by default.
DATABASE_URL="postgresql://knowledge:knowledge@localhost:5432/knowledge_center?schema=public"

# Random 32+ byte secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET="change-me-to-a-long-random-string"

# The single admin account (this app runs in single-admin mode: anyone can read,
# only this account can write). Generate the hash with:
#   npm run auth:hash -- "your-password"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD_HASH="$2a$12$replace-with-a-bcrypt-hash"

# Public origin of the deployment, used for absolute links/metadata.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
