{
  "name": "knowledge-center",
  "version": "0.1.0",
  "private": true,
  "description": "Open Knowledge & Memory Center — a self-hostable developer knowledge base.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "envvault run ${ENV_VAULT_PROJECT:-cheet-sheet} -- next dev",
    "build": "next build",
    "start": "envvault run ${ENV_VAULT_PROJECT:-cheet-sheet} -- next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "envvault run ${ENV_VAULT_PROJECT:-cheet-sheet} -- prisma migrate dev",
    "db:migrate:deploy": "envvault run ${ENV_VAULT_PROJECT:-cheet-sheet} -- prisma migrate deploy",
    "db:push": "envvault run ${ENV_VAULT_PROJECT:-cheet-sheet} -- prisma db push",
    "db:seed": "envvault run ${ENV_VAULT_PROJECT:-cheet-sheet} -- tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "auth:hash": "tsx scripts/hash-password.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "bcryptjs": "^2.4.3",
    "cmdk": "^1.1.1",
    "d3-force": "^3.0.0",
    "jose": "^5.9.6",
    "next": "^16.3.4",
    "pg": "^8.13.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "dotenv": "^16.4.7",
    "eslint": "^9.17.0",
    "eslint-config-next": "^16.3.4",
    "jsdom": "^25.0.1",
    "prisma": "^7.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
